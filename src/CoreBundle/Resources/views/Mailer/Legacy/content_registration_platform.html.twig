    {% set user_locale = locale is defined ? locale : 'pl' %}
{% trans_default_domain 'messages' %}

{% autoescape false %}
    <p>Szanowna/y {{ complete_name }},</p>
    <p>Witamy na {{ 'platform.site_name' | api_get_setting }}</p>
    <p>Twój formularz rekrutacyjny został przesłany i oczekuje na weryfikację.</p>
    <p>Gdy tylko zostanie ona zakończona, otrzymasz powiadomienie na podany adres e-mail.</p>
    <p>Poniżej znajdują się dane logowania do platformy:</p>
    <p>Nazwa użytkownika: {{ login_name }}<br>
        Hasło: ***********</p>
    <br>
    <p>Aby uzyskać więcej informacji, odwiedź <a href="{{ search_link }}">{{ search_link }}</a></p>
    <p>{{ 'In case of trouble, contact us.'|trans({}, 'messages', user_locale) }}</p>
    <br>
    <p>{{ 'Sincerely'|trans({}, 'messages', user_locale) }}</p>
    <p>{{ 'admin.administrator_name' | api_get_setting }} {{ 'admin.administrator_surname' | api_get_setting }}<br />
        {{ 'Manager'|trans({}, 'messages', user_locale) }} {{ 'platform.site_name' | api_get_setting }}<br />

        {% if 'admin.administrator_phone' | api_get_setting %}
            {{ 'T. ' ~ 'admin.administrator_phone' | api_get_setting }}<br />
        {% endif %}
        {% if 'admin.administrator_email' | api_get_setting %}
            {{ 'Email'|trans({}, 'messages', user_locale) ~ ': ' ~ 'admin.administrator_email' | api_get_setting }}
        {% endif %}
    </p>
{% endautoescape %}
